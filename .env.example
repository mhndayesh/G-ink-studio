# G-Ink Studio — Docker environment
# Copy this file to .env and fill in your values, then run: docker compose up --build
#
# Nothing here is required. Without an LLM key every AI button still works
# via deterministic fallback output.

# ── LLM provider ──────────────────────────────────────────────────────────
# OpenAI or any OpenAI-compatible API (LM Studio, Ollama, etc.)
MANGA_LLM_ENABLED=true
MANGA_LLM_PROVIDER=openai
MANGA_OPENAI_API_KEY=sk-...
MANGA_OPENAI_MODEL=gpt-4.1-mini
# For a local model (LM Studio default): http://localhost:1234/v1
MANGA_OPENAI_BASE_URL=https://api.openai.com/v1
MANGA_LLM_TIMEOUT_SECONDS=60

# ── Frontend API URL ───────────────────────────────────────────────────────
# Change only if running on a remote server (replace localhost with your IP/domain)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
