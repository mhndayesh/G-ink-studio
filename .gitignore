# Six official story templates are canonical at apps/api/app/templates/.
# Per-story user data lives under apps/api/storage/stories/ and the SQLite
# registry sits next to it. Both are local working state, not source.
storage/stories/
storage/*.sqlite
storage/*.sqlite-journal
**/storage/stories/
**/storage/*.sqlite
**/storage/*.sqlite-journal
**/storage/*.db

