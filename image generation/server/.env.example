# G-Ink Studio v2 — environment variables
# Copy this file to .env and fill in the values you need.
# All variables are optional; defaults are shown.

# ── LLM provider ──────────────────────────────────────────────────────────────
AI_PROVIDER=auto
# auto = try anthropic → openai → lmstudio → off
# other options: anthropic | openai | lmstudio | off

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=

# ── Image generation ──────────────────────────────────────────────────────────
IMAGE_SERVER_TYPE=placeholder
# options: placeholder | comfyui | http
IMAGE_SERVER_URL=http://localhost:8188

# ── ComfyUI — stock SDXL workflow (defaults, no file needed) ──────────────────
# Leave COMFY_WORKFLOW_PATH empty to use the built-in SDXL t2i/i2i workflows.
COMFY_WORKFLOW_PATH=
COMFY_I2I_WORKFLOW_PATH=
COMFY_CKPT=sd_xl_base_1.0.safetensors
COMFY_STEPS=28
COMFY_CFG=7

# Node IDs for the t2i workflow (stock SDXL defaults)
COMFY_POSITIVE_NODE=6
COMFY_NEGATIVE_NODE=7
COMFY_SAMPLER_NODE=3
COMFY_SIZE_NODE=5
COMFY_CKPT_NODE=4
COMFY_OUTPUT_NODE=9

# Override the negative prompt sent to ComfyUI. Leave unset to use the system-rule
# negative. Set to "no text" or "" for FLUX/Qwen — SD-style negative tags (color,
# photo, 3d render...) cause distortion on models trained with empty negatives.
# COMFY_NEGATIVE_OVERRIDE=no text

# Node IDs for the i2i workflow (stock SDXL defaults — same as t2i except LoadImage)
COMFY_I2I_POSITIVE_NODE=
COMFY_I2I_POSITIVE_INPUT=text
COMFY_I2I_NEGATIVE_NODE=
COMFY_I2I_SAMPLER_NODE=
COMFY_I2I_OUTPUT_NODE=
COMFY_LOAD_IMAGE_NODES=11
COMFY_I2I_DENOISE=0.75

# ── ComfyUI — Qwen GGUF workflows (fill these in if you use Qwen) ─────────────
# Set COMFY_CKPT_NODE=_none for GGUF workflows (no CheckpointLoaderSimple node).
#
# COMFY_WORKFLOW_PATH=./workflows/qwen-t2i.json
# COMFY_POSITIVE_NODE=7
# COMFY_NEGATIVE_NODE=13
# COMFY_SAMPLER_NODE=5
# COMFY_SIZE_NODE=9
# COMFY_OUTPUT_NODE=15
# COMFY_CKPT_NODE=_none
#
# COMFY_I2I_WORKFLOW_PATH=./workflows/qwen-i2i.json
# COMFY_I2I_POSITIVE_NODE=48
# COMFY_I2I_POSITIVE_INPUT=prompt
# COMFY_I2I_NEGATIVE_NODE=51
# COMFY_I2I_SAMPLER_NODE=42
# COMFY_I2I_OUTPUT_NODE=50
# COMFY_LOAD_IMAGE_NODES=39
# COMFY_I2I_DENOISE=1
#
# i2i-2refs render mode (BatchImagesNode, 2 reference images)
# COMFY_2REF_WORKFLOW_PATH=./workflows/qwen-i2i-2refs.json
# COMFY_2REF_POSITIVE_NODE=7
# COMFY_2REF_POSITIVE_INPUT=prompt
# COMFY_2REF_NEGATIVE_NODE=10
# COMFY_2REF_SAMPLER_NODE=3
# COMFY_2REF_OUTPUT_NODE=9
# COMFY_2REF_LOAD_IMAGE_NODES=14,16
#
# i2i-3refs render mode (BatchImagesNode, 3 reference images)
# COMFY_3REF_WORKFLOW_PATH=./workflows/qwen-i2i-3refs.json
# COMFY_3REF_POSITIVE_NODE=7
# COMFY_3REF_POSITIVE_INPUT=prompt
# COMFY_3REF_NEGATIVE_NODE=10
# COMFY_3REF_SAMPLER_NODE=3
# COMFY_3REF_OUTPUT_NODE=9
# COMFY_3REF_LOAD_IMAGE_NODES=14,16,18

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8788
PARALLEL_RENDERS=3
GINK_DB_PATH=
