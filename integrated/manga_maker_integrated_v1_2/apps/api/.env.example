MANGA_STORAGE_ROOT=storage/stories
MANGA_REGISTRY_SQLITE_PATH=storage/manga_registry.sqlite
MANGA_REGISTRY_BACKEND=sqlite
MANGA_DATABASE_URL=postgresql+psycopg://manga:manga@localhost:5432/manga_maker
MANGA_AUTH_ENABLED=false
MANGA_DEV_USER_ID=dev_user
MANGA_DEV_API_KEY=
MANGA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MANGA_LLM_ENABLED=false
MANGA_LLM_PROVIDER=openai
MANGA_OPENAI_API_KEY=
MANGA_OPENAI_MODEL=gpt-4.1-mini

# Neo4j graph projection. If disabled, projections are stored locally only.
MANGA_NEO4J_ENABLED=false
MANGA_NEO4J_URI=bolt://localhost:7687
MANGA_NEO4J_USER=neo4j
MANGA_NEO4J_PASSWORD=
MANGA_NEO4J_DATABASE=neo4j

# Qdrant vector memory. If disabled, vector metadata is stored locally only.
MANGA_QDRANT_ENABLED=false
MANGA_QDRANT_URL=http://localhost:6333
MANGA_QDRANT_API_KEY=
MANGA_QDRANT_VECTOR_SIZE=384
